{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/candidates", "destination": "/data/candidates.json" },
    { "source": "/api/opportunities", "destination": "/data/opportunities.json" },
    { "source": "/api/apply", "destination": "/data/success.json" },
    { "source": "/api/request", "destination": "/data/success.json" },
    { "source": "/api/interest", "destination": "/data/success.json" }
  ]
}
